# Bu dosyayı kopyalayıp .env.local yapın ve değerleri doldurun.

# Supabase proje ayarları -> API
# Boş bırakılırsa uygulama geliştirme modunda bellekteki fallback ile çalışır.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel'deki site adresiniz (örn. https://proje-adin.vercel.app).
# Paylaşım önizlemeleri (OG) tam URL gerektirdiği için önemli.
NEXT_PUBLIC_SITE_URL=
